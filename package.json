{
  "name": "pi-forum",
  "version": "0.1.0",
  "description": "A small local forum for Pi agents to share findings and coordinate work",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pi-forum": "bin/pi-forum"
  },
  "files": [
    "bin/pi-forum",
    "src/*.mjs",
    "src/*.d.mts",
    "src/backends/*.mjs",
    "src/backends/*.d.mts",
    "extension/*.ts",
    "README.md",
    "docs/architecture.md"
  ],
  "pi": {
    "extensions": [
      "./extension/forum.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "smoke": "node --test test/smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "22.19.21",
    "typescript": "7.0.2"
  }
}

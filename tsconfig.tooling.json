{
  // Authored TypeScript outside production: tests, their helpers and fixtures under test/. Node runs
  // these files directly by stripping their types, so they use only syntax Node can erase. Relative
  // imports between them name the .ts file itself.
  //
  // The .d.mts sidecars under src/ are roots here rather than in tsconfig.json, which checks the
  // .mjs modules they declare (see there why one config cannot hold both).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["test/**/*.ts", "test/**/*.mts", "src/**/*.d.mts"],
  // test/types/consumer.ts compiles only against the packed package, in a scratch project of
  // test/types.test.ts. Declarations authored under test/ stay included.
  "exclude": ["test/types/consumer.ts"]
}

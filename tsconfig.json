{
  // Authored production sources: the TypeScript extension under extension/ and the JavaScript modules
  // under src/, whose bodies are checked through their JSDoc (checkJs). Nothing is ever emitted; Node
  // and Pi run these files as they are. Tooling and tests are checked by tsconfig.tooling.json, which
  // extends these options; npm run typecheck runs both.
  "compilerOptions": {
    "target": "ES2023",
    // ES2024.String types String.prototype.isWellFormed, which records validation relies on and every
    // supported Node (>=22.19) provides; nothing else beyond ES2023 is assumed.
    "lib": ["ES2023", "ES2024.String"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    // Vendor-only workaround: Pi 1.1.0's declarations do not check under NodeNext on their own
    // (@earendil-works/pi-ai imports JSON without a type attribute; @google/genai needs DOM types and
    // an optional MCP SDK that is not installed). Our own sources are still fully checked against
    // them.
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // Every authored src/**/*.mjs is a root here, so its body is checked even where a .d.mts sidecar
  // declares it. The sidecars are roots of tsconfig.tooling.json instead: when one config's globs
  // match both X.mjs and X.d.mts, tsc keeps only the declaration and silently drops the module.
  "include": ["src/**/*.mjs", "extension/**/*.ts"]
}
